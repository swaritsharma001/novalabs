<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B0A">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/llModalHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0D1613"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvModalTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PopPay Checkout · ₹100.00"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Cancel / Dismiss Button (Like onDismiss in checkout.js) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelModal"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="✕ Close"
            android:textAllCaps="false"
            android:textColor="#EF4444"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="#10B981"
        app:layout_constraintTop_toBottomOf="@id/llModalHeader" />

    <!-- In-App WebView for PopPay checkout iframe/modal -->
    <WebView
        android:id="@+id/wvPopPay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pbLoading" />

</androidx.constraintlayout.widget.ConstraintLayout>
